	</parameter>
	<parameter name="mat_deb" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="mat_fin" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Presidence_Rapport\\subreport\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="titre" class="java.lang.String"/>
	<parameter name="LOGO_SOC" class="java.awt.Image"/>
	<queryString>
		<![CDATA[SELECT DISTINCT p.mat_pers,
       CAST(ISNULL(REPLACE(p.mat_pers, ' ', ''), '0') AS DECIMAL(18,0)) AS mat_num,
       CASE p.cod_sit
            WHEN 'M' THEN 'Marié(e)'
            WHEN 'C' THEN 'Célibataire'
            WHEN 'V' THEN 'Veuf(ve)'
            ELSE 'Autre' END AS situation_familiale,
       p.etat_act,
       CONCAT(p.nom_pers, ' ', p.pren_pers) AS nom_complet,
       p.dat_nais,
       p.cin,
       p.sexe,
       CASE p.sexe
            WHEN 'M' THEN 'Masculin'
            WHEN 'F' THEN 'Féminin'
            ELSE 'Non disponible' END AS lib_sexe,
       p.dat_emb,
       p.num_retr,
       p.corps,
       c.lib_corps,
       p.cod_retr,
       p.cod_soc,
       p.cod_affect,
       p.lieu_nais,
       p.nbr_enf
  FROM personnel p
  LEFT JOIN corps c
    ON p.corps = c.cod_corps
 WHERE p.cod_soc = $P{cod_soc}
   AND CAST(ISNULL(REPLACE(p.mat_pers, ' ', ''), '0') AS DECIMAL(18,0))
       BETWEEN ISNULL(CAST(NULLIF($P{mat_deb}, '') AS DECIMAL(18,0)),
                      CAST(ISNULL(REPLACE(p.mat_pers, ' ', ''), '0') AS DECIMAL(18,0)))
           AND ISNULL(CAST(NULLIF($P{mat_fin}, '') AS DECIMAL(18,0)),
                      CAST(ISNULL(REPLACE(p.mat_pers, ' ', ''), '0') AS DECIMAL(18,0)))
 ORDER BY mat_num]]>
	</queryString>
