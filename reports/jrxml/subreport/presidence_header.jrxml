<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="presidence_header" language="groovy" pageWidth="555" pageHeight="61" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="titre" class="java.lang.String"/>
	<parameter name="LOGO_SOC" class="java.awt.Image"/>
	<title>
		<band height="61">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" isUsingCache="true" onErrorType="Blank">
				<reportElement x="0" y="0" width="140" height="52"/>
				<imageExpression class="java.awt.Image"><![CDATA[$P{LOGO_SOC}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="true">
				<reportElement x="150" y="8" width="255" height="36"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{titre}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="445" y="8" width="110" height="16"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="58" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="0.75" lineColor="#808080"/>
				</graphicElement>
			</line>
		</band>
	</title>
</jasperReport>
