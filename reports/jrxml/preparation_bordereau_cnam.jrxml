<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="preparation_bordereau_cnam" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.3636363636363635"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="cod_soc" class="java.lang.String">
		<defaultValueExpression><![CDATA["01"]]></defaultValueExpression>
	</parameter>
	<parameter name="bord" class="java.lang.String">
		<defaultValueExpression><![CDATA["C201011"]]></defaultValueExpression>
	</parameter>
	<parameter name="titre" class="java.lang.String"/>
	<parameter name="LOGO_SOC" class="java.awt.Image"/>
	<queryString>
		<![CDATA[select bu.cod_soc,
       bu.mat_pers,
       bu.dat_soin,
       bu.dat_saisie,
       concat(concat(coalesce(p.nom_pers, ''), ' '),
              coalesce(p.pren_pers, '')) as nom_prenom_adherent,
       bu.num_fam,
       coalesce(f.nom_pren, 'Adhérent') as pren_benef,
       bu.num_soin,
       p.num_retr,
       bu.tot_net,
       (select coalesce(sum(coalesce(l.mnt_honor, 0)), 0)
          from lig_bult l
         where l.cod_soc = bu.cod_soc
           and l.mat_pers = bu.mat_pers
           and l.num_fam = bu.num_fam
           and l.dat_soin = bu.dat_soin) AS total_honor,
       (select count(*)
          from bult_soin bs
         where bs.cod_soc = bu.cod_soc
           and bs.mat_pers = bu.mat_pers
           and bs.cod_bord = bu.cod_bord
           and bs.nat_bult = 'C'
           and coalesce(bs.envoi, 'N') = 'O') AS nb_bs,
       s.lib_soc
  from bult_soin bu
  join personnel p
    on p.cod_soc = bu.cod_soc
   and p.mat_pers = bu.mat_pers
  join societe s
    on s.cod_soc = bu.cod_soc
  left join famille f
    on bu.cod_soc = f.cod_soc
   and bu.mat_pers = f.mat_pers
   and bu.num_fam = f.num_fam
 where bu.cod_soc = $P{cod_soc}
   and bu.cod_bord = $P{bord}
   and bu.nat_bult = 'C'
   and coalesce(bu.envoi, 'N') = 'O'
 order by bu.dat_saisie, cast(bu.mat_pers as numeric), bu.num_fam]]>
	</queryString>
